# ===== 大模型（任何 OpenAI 兼容接口都能用）=====
# OpenAI:      https://api.openai.com/v1        模型 gpt-4o-mini / gpt-4.1-mini
# DeepSeek:    https://api.deepseek.com/v1      模型 deepseek-chat
# 月之暗面:    https://api.moonshot.cn/v1       模型 moonshot-v1-32k
# 阿里百炼:    https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
# 智谱:        https://open.bigmodel.cn/api/paas/v4                模型 glm-4-plus
# 本地 Ollama: http://127.0.0.1:11434/v1        模型 qwen2.5:14b（Key 随便填）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 生成温度，0.2~0.6 比较稳
LLM_TEMPERATURE=0.4
# 单次回复上限。推理型模型（deepseek-flash、o 系列）会先"思考"再回答，
# 思考也占 token，给小了会出现 JSON 被截断。建议不低于 8192
LLM_MAX_TOKENS=8192
# 推理强度（仅推理型模型支持）：low | high | max
# 本项目输出的是结构化 JSON，low 通常够用，还能显著更快、更省、少截断；留空则不发送
LLM_REASONING_EFFORT=
# 单次请求超时（毫秒）。推理模型首字很慢，不要低于 180000
LLM_TIMEOUT_MS=180000

# ===== 联网检索增强（完全可选，不配也能用）=====
# 配置后，生成复习资料和拓展知识点时会先检索真实资料注入给模型，内容更全、更新。
# 不绑定服务商，SEARCH_PROVIDER 任选一家：
#   tavily   https://tavily.com              免费 1000 次/月，结果已清洗成适合喂模型的正文（默认）
#   bocha    https://bochaai.com             国内直连，中文资料质量好，按量付费
#   brave    https://brave.com/search/api    独立索引，免费额度需绑卡
#   serper   https://serper.dev              Google 结果，便宜，量大
#   searxng  自建元搜索，完全免费，SEARCH_ENDPOINT 填自己的实例（如 http://127.0.0.1:8080/search）
#   custom   任意 Tavily 兼容接口，SEARCH_ENDPOINT 指向它
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# 留空则用该服务商的默认地址；自建 searxng 或私有网关时填这里
SEARCH_ENDPOINT=
SEARCH_TIMEOUT_MS=15000

# ===== 服务 =====
PORT=8787
# 数据落盘目录（JSON 文件，无需数据库）
DATA_DIR=./data

# 演示模式：不调用大模型，用内置样例数据跑通全流程（无需 API Key）
DEMO_MODE=0

# ===== 部署到公网时建议开启 =====
# 访问令牌：设置后所有 /api 接口（除 /api/health）都要带 x-token 头或 ?token= 参数，
# 前端首次访问会弹窗输入。本地自用留空即可，完全开放
ACCESS_TOKEN=
# 数据备份：每次写入前对 db.json 做节流快照（至少间隔 30 分钟），最多保留 N 份到 data/backups/
BACKUP_KEEP=10
